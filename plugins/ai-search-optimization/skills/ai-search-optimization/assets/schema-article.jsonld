  "description": "<<One-sentence summary of the article, ≤160 characters>>",
  "image": [
    "<<https://example.com/img/hero-1200x900.jpg>>"
  ],
  "datePublished": "<<2026-05-16T08:00:00-07:00>>",
  "dateModified": "<<2026-05-16T08:00:00-07:00>>",
  "author": {
    "@type": "Person",
    "name": "<<Author Full Name>>",
    "url": "<<https://example.com/authors/author-slug>>",
    "jobTitle": "<<Senior X Engineer>>",
    "sameAs": [
      "<<https://www.linkedin.com/in/author-handle/>>",
      "<<https://github.com/author-handle>>"
    ]
  },
  "publisher": {
    "@type": "Organization",
