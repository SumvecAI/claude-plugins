    "name": "<<Example Co.>>",
    "logo": {
      "@type": "ImageObject",
      "url": "<<https://example.com/logo-512x512.png>>"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "<<https://example.com/blog/post-slug>>"
  },
  "articleSection": "<<Section name, e.g. Engineering>>",
  "wordCount": <<1850>>,
  "keywords": "<<comma, separated, keywords>>"
}
</script>
