<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "<<How to do X>>",
  "description": "<<One-sentence summary of the procedure>>",
  "image": "<<https://example.com/img/hero.jpg>>",
  "totalTime": "<<PT30M>>",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "USD",
    "value": "<<25>>"
  },
  "supply": [
    { "@type": "HowToSupply", "name": "<<Item 1>>" },
    { "@type": "HowToSupply", "name": "<<Item 2>>" }
  ],
  "tool": [
    { "@type": "HowToTool", "name": "<<Tool 1>>" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "name": "<<Step 1 title>>",
      "text": "<<Step 1 instructions, 1–3 sentences.>>",
      "image": "<<https://example.com/img/step-1.jpg>>",
      "url": "<<https://example.com/howto-x#step-1>>"
    },
    {
      "@type": "HowToStep",
      "name": "<<Step 2 title>>",
      "text": "<<Step 2 instructions.>>",
      "image": "<<https://example.com/img/step-2.jpg>>",
      "url": "<<https://example.com/howto-x#step-2>>"
    }
  ]
}
</script>
